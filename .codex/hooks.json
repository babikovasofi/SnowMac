{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash .codex/hooks/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash .codex/hooks/prompt-router.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash .codex/hooks/guard.sh",
            "timeout": 15
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 .codex/hooks/quality.py before",
            "timeout": 15
          }
        ],
        "matcher": "^(Bash|apply_patch)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 .codex/hooks/quality.py after",
            "timeout": 600
          }
        ],
        "matcher": "^(Bash|apply_patch)$"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash .codex/hooks/subagent-greeting.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash .codex/hooks/exec-return-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 .codex/hooks/quality.py stop",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && bash .codex/hooks/slop-gate.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
